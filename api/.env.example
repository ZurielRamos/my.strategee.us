NODE_ENV=development

APP_URL=http://localhost:8100
FRONTEND_URL=https://my.strategee.us

JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name
DB_SYNC=true

# Notifications Configuration
# Número de días para retener notificaciones antes de eliminarlas automáticamente
# La limpieza se ejecuta diariamente a las 2 AM
NOTIFICATIONS_RETENTION_DAYS=90

# Firebase Configuration
# Credenciales de Firebase Admin SDK para autenticación del servidor
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Push Notification Settings
# Número de días para retener tokens inactivos antes de eliminarlos automáticamente
# La limpieza se ejecuta diariamente a las 3 AM
PUSH_TOKEN_RETENTION_DAYS=30

# Password Vault Encryption Configuration
# Clave secreta para cifrado AES-256 de credenciales (mínimo 32 caracteres)
ENCRYPTION_SECRET=your_encryption_secret_key_min_32_chars
# Salt para derivación de clave de cifrado (mínimo 16 caracteres)
ENCRYPTION_SALT=your_encryption_salt_min_16_chars
# Google Workspace (Calendar, Tasks, Docs, Drive)
# Cliente OAuth tipo "Web" del proyecto de Firebase (Google Cloud Console > Credenciales)
GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-web-client-secret
# Solo los usuarios de este dominio reciben los permisos de Workspace
GOOGLE_WORKSPACE_DOMAIN=strategee.us
# API de actas (recapmeeting). Opcional: por defecto https://recapmeeting.com/apis
RECAPMEETING_API_URL=https://recapmeeting.com/apis
# Clave compartida: debe ser igual a ApisController::MS_API_KEY en recapmeeting (mínimo 32 caracteres)
RECAPMEETING_API_KEY=genera-una-clave-aleatoria-de-al-menos-32-caracteres

# SMTP (envío de correos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true para el puerto 465, false para 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_password_or_app_password
MAIL_FROM='"My Strategee" <your_smtp_user@example.com>'
