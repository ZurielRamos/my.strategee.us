{
  "name": "my-strategee",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix app && pnpm install --prefix api",
    "build:app": "npm run build --prefix app",
    "build:api": "pnpm run build --prefix api",
    "build": "npm run build:app && npm run build:api",
    "start": "node api/dist/main",
    "start:prod": "node api/dist/main",
    "start:dev:api": "pnpm run start:dev --prefix api",
    "start:dev:app": "npm run start --prefix app",
    "deploy": "bash deploy.sh"
  }
}
