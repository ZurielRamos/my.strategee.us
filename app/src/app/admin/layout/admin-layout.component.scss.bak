:host {
    display: block;
    height: 100%;
}

ion-split-pane {
    --side-width: 260px;
    --border: 0;
}

.admin-sidebar {
    &::part(container) {
        background: var(--app-sidebar-bg);
        color: var(--app-sidebar-text);
        border-radius: 20px;
        margin: 16px;
        width: calc(100% - 32px);
        max-width: 260px;
        height: calc(100% - 32px);
        box-shadow: 0 4px 16px var(--app-shadow);
    }
}

.sidebar-content {
    --background: var(--app-sidebar-bg);
    --color: var(--app-sidebar-text);
    --padding-top: 10px;
}

.sidebar-header {
    display: flex;
    align-items: center;
    padding: 30px;

    .logo-icon {
        font-size: 28px;
        color: var(--ion-color-primary, #bcf36a);
        margin-right: 12px;
    }

    .logo-text {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.5px;
        color: var(--app-sidebar-text);
    }
}

.sidebar-list {
    background: transparent;
    padding: 0 16px;
}

.menu-item {
    --background: transparent;
    --color: var(--app-sidebar-text-secondary);
    --padding-start: 16px;
    --padding-end: 16px;
    --min-height: 48px;
    border-radius: 24px;
    margin-bottom: 8px;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease-in-out;

    ion-icon {
        color: var(--app-sidebar-text-secondary);
        font-size: 20px;
        margin-right: 14px;
    }

    .requests-badge {
        --background: var(--ion-color-primary, #bcf36a);
        --color: var(--app-background-alt);
        font-size: 11px;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 12px;
        min-width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
}

.menu-item.selected {
    --background: var(--app-sidebar-active);
    --color: var(--app-text-primary);

    ion-icon {
        color: var(--app-text-primary);
    }

    .menu-badge {
        background: var(--ion-color-primary, #bcf36a);
        color: var(--app-text-primary);
    }

    .requests-badge {
        --background: var(--app-text-primary);
        --color: var(--app-background-alt);
    }
}

.menu-item:hover:not(.selected) {
    --background: var(--app-sidebar-hover);
    --color: var(--app-sidebar-text);

    ion-icon {
        color: var(--app-sidebar-text);
    }
}

.menu-badge {
    background: transparent;
    color: var(--app-sidebar-text-secondary);
    font-size: 12px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 12px;
}

.menu-badge.active-badge {
    background: var(--ion-color-primary, #bcf36a);
    color: var(--ion-color-primary-contrast, var(--app-text-primary));
}

.upgrade-card-container {
    padding: 24px 16px;
    margin-top: auto;
}

.upgrade-card {
    background: var(--ion-color-primary, #bcf36a);
    border-radius: 20px;
    padding: 24px;
    position: relative;
    overflow: hidden;
    color: var(--ion-color-primary-contrast, #1a1c1b);
    display: flex;
    flex-direction: column;

    .upgrade-title {
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 8px 0;
        z-index: 2;
    }

    .upgrade-text {
        font-size: 13px;
        opacity: 0.9;
        margin: 0 0 20px 0;
        line-height: 1.4;
        z-index: 2;
        padding-right: 10px;
    }

    .upgrade-image-placeholder {
        font-size: 40px;
        position: absolute;
        bottom: 50px;
        right: -10px;
        z-index: 1;
        opacity: 0.9;
    }

    .upgrade-btn {
        background: var(--app-text-primary);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 12px 0;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        z-index: 2;
        transition: transform 0.2s ease;
        margin-top: 20px;

        &:active {
            transform: scale(0.98);
        }
    }
}

#main-content {
    background-color: var(--app-background) !important;
}

@media (min-width: 992px) {
    #main-content {
        border-radius: 20px;
        margin: 16px 16px 16px 0;
        box-shadow: 0 4px 16px var(--app-shadow);
        overflow: hidden;
    }
}

.sidebar-user-footer {
    padding: 16px;

    app-user-profile {
        display: block;

        ::ng-deep .user-profile-wrapper {
            background: var(--app-sidebar-hover);
            padding: 10px 14px;

            &:hover {
                background: rgba(255, 255, 255, 0.08);
            }

            .user-name,
            .user-role {
                color: var(--app-sidebar-text);
            }

            .user-name ion-icon {
                color: var(--app-sidebar-text-secondary);
            }
        }
    }
}