.position-card {
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 16px;
    box-shadow: 0 2px 8px var(--app-shadow);
    margin: 0;
    background: var(--app-card-bg);

    &:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
    }

    ion-card-header {
        padding: 20px 20px 12px 20px;

        ion-card-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--app-text-primary);
            margin: 0;
        }
    }

    ion-card-content {
        padding: 12px 20px 20px 20px;

        .position-info {
            display: flex;
            flex-direction: column;
            gap: 12px;

            .info-row {
                display: flex;
                flex-direction: column;
                gap: 4px;

                .label {
                    font-size: 12px;
                    color: var(--app-text-secondary);
                    font-weight: 500;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

                .value {
                    font-size: 15px;
                    color: var(--app-text-primary);
                    font-weight: 500;
                }

                .risk-badge {
                    display: inline-block;
                    padding: 6px 12px;
                    border-radius: 8px;
                    font-size: 13px;
                    font-weight: 700;
                    width: fit-content;

                    &[data-risk="I"] {
                        background: #d4edda;
                        color: #155724;
                    }

                    &[data-risk="II"] {
                        background: #d1ecf1;
                        color: #0c5460;
                    }

                    &[data-risk="III"] {
                        background: #fff3cd;
                        color: #856404;
                    }

                    &[data-risk="IV"] {
                        background: #f8d7da;
                        color: #721c24;
                    }

                    &[data-risk="V"] {
                        background: #f5c6cb;
                        color: #721c24;
                    }
                }
            }
        }
    }
}
